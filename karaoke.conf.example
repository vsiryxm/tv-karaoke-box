# karaoke.conf 配置示例 —— 定制版（--flavor live）专用
# UTF-8、一行一个 key=value、井号开头是注释；键名大小写不敏感，值里的 \n 表示换行。
#
# 用法：
#   1) 构建期：把本文件复制成仓库根目录的 karaoke.conf（不入库），改台名/默认提醒时段，
#      再跑 ./build.sh --flavor live。白名单键会打进 APK 的 assets/karaoke.conf 作默认值。
#      开源版（./build.sh）不读这个文件，台名固定「K歌台」，也不写入下面任何专属键。
#   2) 运行期：把这个文件放到 U 盘根目录（文件名必须是 karaoke.conf），
#      插回电视自动重扫生效，不用重装 App。U 盘值 > 构建期默认值 > 内置默认。
#
# 文件不存在、写错、读失败都不影响唱歌；下面所有专属键只对定制版有意义。

# ---------- 通用键（两个 flavor 都认） ----------

# 台名：启动页、顶栏、跑马灯欢迎语都用它；也是安装后的应用名（构建期写入）。
APP_NAME=K歌台

# 跑马灯欢迎语；不写就自动用「欢迎来到 <台名>，」
welcome=欢迎来到 K歌台，

# ---------- 报幕词（只在直播模式显示） ----------

# 报幕词最多停留秒数，默认 30；开唱 2 秒后提前收，至少留 6 秒。
opening_secs=30

# 写 1 = 开唱也不提前收，一直停到秒数用完（整段词要念完时用）。默认 0。
opening_hold=0

# 报幕词从 U 盘根目录的 karaoke_openings.txt 按名字取，格式见
# karaoke_openings.example.txt；节目单与台词解耦，不要在节目单里塞大段正文。

# ---------- 四种提醒（只在直播模式显示） ----------

# live_start / live_end 必须同时存在、都是严格 HH:mm
# （24 小时制、两位小时 + 半角冒号 + 两位分钟），且结束晚于开始。
# 18:5、25:00、8:30、18：30 都不合法；任一不合法或区间倒置 → 按时钟触发的提醒关闭。
# 不支持跨夜时段。按电视本机钟点判断（Calendar 取设备时区），不是手机时间。
# 排查坑：老电视的 adb shell date 是 busybox，TZ 为空时显示 UTC（慢 8 小时），
# 那只是 shell 假象；核对请用 adb shell dumpsys alarm | head -3 里的 now=。
live_start=18:30
live_end=20:00

# 正式节目数（例如 14）。中场和下播预告只按正式节目计算，之后的节目可留作备用。
# 指定节目结束时弹庆祝层并暂停推进，庆祝层收起后按 OK 继续。每场只弹一次。
# 不填、填 0 或超出清单长度时，按整个节目单安排提醒。
# live_end_program=14

# 四种提醒的文案，可改；下播预告文案里的 %d 会替换成「还剩几个节目」。
# 注意：下播提醒是全屏庆祝页（礼花），固定显示 live_end_text + 「主播辛苦了！」。
live_start_text=直播开始啦
live_break_text=中场休息一下
live_warn_text=还有 %d 个节目
live_end_text=直播结束啦

# 触发时机：
#   开播提醒   —— 到 live_start 且仍在时段内（开机晚了会补一次）。
#                  这一场还没开演的话，自动定位到第 1 个节目并停下，等主播按 OK 开演；
#                  已经在演了就不打断。
#   中场休息   —— 正式节目走到第 floor(N/2)+1 项时提示。
#   下播预告   —— 正式节目走到倒数第 2 项时提示。
#   下播提醒   —— 指定节目结束后弹出。未指定有效位次时，等到 live_end 且整场演完。
#                  庆祝层 15 秒自动收起，任意键可提前收起。
# 同一分钟命中多条时显示最新的一条；提醒只在直播模式出现。

# ---------- 节目单（U 盘根目录 karaoke_program.txt） ----------
# 格式：演唱|磁盘歌文件名（不含 .mp3）  或  弹奏|节目名；# 开头是注释，严格按行序演出。
# 演唱类：唱完自动进下一个节目；只缺伴奏照常播原唱，mp3 与 lrc 同时缺才跳过并记一行日志。
# 弹奏类：没有音频文件，进入即停住，按 OK 进下一个节目；1 原唱/伴奏、2 重唱在该状态禁用。
# 演到最后一个节目停住，不自动循环；按 OK 从头再演。
# 示例见 karaoke_program.example.txt。
