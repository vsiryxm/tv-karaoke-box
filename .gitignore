# 本地配置与私人数据（一律不入库）
config.env
karaoke.conf
karaoke_program.txt
karaoke_openings.txt
karaoke_setlist.txt
# 例外：docs/backup/ 是有意入库的直播配置备份，覆盖上面的同名忽略
!docs/backup/karaoke.conf
!docs/backup/karaoke_program.txt
!docs/backup/karaoke_openings.txt

# 定制版产物：构建期可能写入私人台名 / 默认提醒配置，不入库
karaoke-live.apk

# 编译中间产物（strings.xml 由 build.sh 按 flavor 生成，可能含私人台名）
build/
res/values/strings.xml
.DS_Store
*.pyc
__pycache__/

# 说明：karaoke.apk（开源版成品）与 debug.keystore 是故意入库的：
# 前者方便直接装，后者保证 adb install -r 不换签名（仅调试用，见 README）。
